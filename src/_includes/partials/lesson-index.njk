{#-
  トップページの「全7回の一覧表」。
  collections.lessons（order 昇順）から自動生成する。
  第4〜7回は site.json の lessons[].project フラグでまとめて帯を付ける。
  第8回を足したいときは src/lessons/08-xxx.md と site.json に追記するだけ。
-#}
<section class="lesson-index" aria-labelledby="lesson-index-title">
<h2 id="lesson-index-title">全{{ site.totalLessons }}回の道のり</h2>
<div class="lesson-index__scroll">
<table>
<thead>
<tr><th scope="col">回</th><th scope="col">テーマ</th><th scope="col">この回で扱うこと</th></tr>
</thead>
<tbody>
{%- for item in collections.lessons -%}
{%- set l = item.data.lesson -%}
{%- set prevL = collections.lessons[loop.index0 - 1].data.lesson if loop.index0 > 0 else null -%}
{%- set isFirstProject = l.project and (not prevL or not prevL.project) -%}
{%- set isLastProject = l.project and loop.last -%}
{%- if isFirstProject -%}
<tr class="lesson-index__group"><th colspan="3" scope="colgroup">{{ site.project.label }}<small>{{ site.project.note }}</small></th></tr>
{%- endif -%}
<tr{% if l.project %} class="is-project{% if isFirstProject %} is-project--first{% endif %}{% if isLastProject %} is-project--last{% endif %}"{% endif %}>
<td>第{{ l.order }}回</td>
<td><a class="lesson-index__link" href="{{ item.url | rel }}">{{ l.title }}</a>{% if l.worldName %}<span class="lesson-index__world">{{ l.worldName }}</span>{% endif %}</td>
<td>{{ l.summary }}{% if l.topics %}<ul class="lesson-index__topics">{% for t in l.topics %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}</td>
</tr>
{%- endfor -%}
</tbody>
</table>
</div>
</section>
