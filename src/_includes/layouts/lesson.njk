---
layout: layouts/base.njk
bodyClass: page-lesson
---
{%- set steps = exercises[lesson.slug] or [] -%}
<article class="lesson" data-lesson="{{ lesson.slug }}" data-lesson-order="{{ lesson.order }}" data-lesson-title="{{ lesson.title }}" data-ex-keys="{% for s in steps %}{{ s.key }}{% if not loop.last %} {% endif %}{% endfor %}">

  <header class="lesson__header">
    <p class="lesson__kicker">
      <span class="lesson__no">第{{ lesson.order }}回</span>
      {% if lesson.worldName %}<span class="lesson__world">{{ lesson.worldName }}</span>{% endif %}
      {% if lesson.project %}<span class="badge badge--project">{{ site.project.shortLabel }}</span>{% endif %}
      <span class="badge badge--done" data-lesson-done-badge hidden>完了</span>
    </p>
    <h1 class="lesson__title">{{ lesson.title }}</h1>
    {% if lesson.summary %}<p class="lesson__summary">{{ lesson.summary }}</p>{% endif %}
    {% if lesson.topics %}
    <ul class="lesson__topics">
      {%- for t in lesson.topics %}<li>{{ t }}</li>{% endfor -%}
    </ul>
    {% endif %}
    <div class="lesson__actions">
      <a class="button button--ghost" href="{{ ('downloads/' + lesson.slug + '.zip') | rel }}" download>
        <svg class="icon" aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M10 3v9m0 0-3.5-3.5M10 12l3.5-3.5M4 14.5V16h12v-1.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        演習ファイル一式（ZIP）
      </a>
      {%- if steps.length %}
      <p class="lesson__progress" data-lesson-progress hidden>
        <span class="meter" aria-hidden="true"><span class="meter__bar" data-lesson-progress-bar></span></span>
        <span data-lesson-progress-text>演習 0 / {{ steps.length }} 問できた</span>
      </p>
      {%- endif %}
    </div>
  </header>

  {#- 目次は config/lesson-enhance.js が見出しから作ってここに入れる -#}
  <div data-lesson-toc></div>

  {#- スクロールすると上に出る細いバー（現在地と目次）。JS が無いときは出さない -#}
  <div class="lesson-bar" data-lesson-bar hidden>
    <div class="lesson-bar__inner">
      <span class="lesson-bar__no">第{{ lesson.order }}回</span>
      <span class="lesson-bar__now" data-lesson-bar-now aria-live="off">{{ lesson.title }}</span>
      <button class="lesson-bar__toggle" type="button" aria-expanded="false" aria-controls="lesson-bar-panel" data-lesson-bar-toggle>
        目次<svg class="icon" aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="m5 8 5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
    <div class="lesson-bar__panel" id="lesson-bar-panel" data-lesson-bar-panel hidden></div>
    <span class="lesson-bar__read" data-lesson-bar-read aria-hidden="true"></span>
  </div>

  {% include "partials/lesson-nav.njk" %}

  <div class="lesson__body prose">
{{ content | safe }}
  </div>
  <span data-lesson-body-end hidden></span>

  {#- 回の完了。読み進めただけでは完了にしない（自分で押す） -#}
  <section class="lesson-complete" aria-labelledby="lesson-complete-title" data-lesson-complete hidden>
    <h2 class="lesson-complete__title" id="lesson-complete-title">第{{ lesson.order }}回のふりかえり</h2>
    <p class="lesson-complete__summary" data-lesson-complete-summary></p>
    <button class="button lesson-complete__button" type="button" aria-pressed="false" data-lesson-complete-toggle>この回を完了にする</button>
    <p class="lesson-complete__note">記録はこのブラウザだけに保存されます。<span data-storage-error hidden>（保存できない設定のため、記録は残りません）</span></p>
  </section>

  {% include "partials/lesson-nav.njk" %}

</article>
